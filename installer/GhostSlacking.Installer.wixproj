<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.3</ProductVersion>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\artifacts\installer-publish\win-x64</PublishDirectory>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDirectory=$(PublishDirectory)</DefineConstants>
    <OutputName>GhostSlacking-$(ProductVersion)-win-x64</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer</OutputPath>
    <!-- Keep WiX incremental state isolated by product version. Otherwise a version
         bump can reuse the previous link cache while CopyFilesToOutputDirectory
         already expects the new versioned MSI file name. -->
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer-obj\$(Configuration)\$(ProductVersion)</IntermediateOutputPath>
    <DebugType>none</DebugType>
    <Cultures>zh-CN</Cultures>
    <!-- AllowSameVersionUpgrades intentionally makes the upgrade range inclusive. -->
    <!-- ProgramMenuFolder/DesktopFolder resolve to all-users locations because this is per-machine. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE61;ICE63</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
