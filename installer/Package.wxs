<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Package
    Name="GhostSlacking"
    Manufacturer="GhostSlacking"
    Version="$(ProductVersion)"
    UpgradeCode="AB92C57B-7434-401E-91B7-4878B250E0C7"
    Scope="perMachine"
    Language="2052">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 GhostSlacking。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <netfx:DotNetCompatibilityCheck
      Property="DOTNETRUNTIMECHECK"
      RuntimeType="core"
      Platform="x64"
      Version="8.0.0"
      RollForward="latestPatch" />
    <Launch
      Condition="Installed OR DOTNETRUNTIMECHECK = 0"
      Message="GhostSlacking 需要安装 .NET 8 Runtime x64（不是 Desktop Runtime）。请先访问 https://aka.ms/dotnet/8.0/runtime-win-x64.exe 安装后重试。" />

    <Icon Id="GhostSlacking.exe" SourceFile="$(PublishDirectory)\GhostSlacking.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="GhostSlacking.exe" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GhostSlacking" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="GhostSlacking" />
    </StandardDirectory>

    <Files Directory="INSTALLFOLDER" Include="$(PublishDirectory)\**">
      <Exclude Files="$(PublishDirectory)\**\*.pdb" />
    </Files>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
        Id="ApplicationStartMenuShortcut"
        Name="GhostSlacking"
        Description="GhostSlacking 窗口 Ghost/Peek 工具"
        Target="[INSTALLFOLDER]GhostSlacking.App.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\GhostSlacking"
        Name="InstallerVersion"
        Type="string"
        Value="[ProductVersion]"
        KeyPath="yes" />
    </Component>
  </Package>
</Wix>
